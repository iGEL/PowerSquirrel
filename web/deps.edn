{:paths ["src"
         "test"]
 :deps {org.clojure/clojure {:mvn/version "1.12.1"}
        org.clojure/clojurescript {:mvn/version "1.12.134"}
        com.pitch/uix.core {:mvn/version "1.4.9"}
        com.pitch/uix.dom {:mvn/version "1.4.9"}
        metosin/reitit-frontend {:mvn/version "0.10.1"}}
 :aliases {:dev {:extra-deps {thheller/shadow-cljs {:mvn/version "3.3.6"}
                              binaryage/devtools {:mvn/version "1.0.7"}}}
           :kaocha-cljs {:extra-deps {lambdaisland/kaocha-cljs {:mvn/version "1.5.181"}}
                         :main-opts ["-m" "kaocha.runner"]}
           :lint {:extra-deps {clj-kondo/clj-kondo {:mvn/version "2026.01.19"}}
                  :main-opts ["-m" "clj-kondo.main" "--lint"]}

           :nsorg-check {:extra-deps {nsorg-cli/nsorg-cli {:mvn/version "0.3.1"}}
                         :main-opts ["-m" "nsorg.cli"]}

           :nsorg-fix {:extra-deps {nsorg-cli/nsorg-cli {:mvn/version "0.3.1"}}
                       :main-opts ["-m" "nsorg.cli" "--replace"]}

           :cljfmt-check {:extra-deps {cljfmt/cljfmt {:mvn/version "0.9.2"}}
                          :main-opts ["-m" "cljfmt.main" "check"
                                      "--parallel"
                                      "--remove-multiple-non-indenting-spaces"
                                      "--file-pattern" "\\.(clj[csx]?|edn)$"]}

           :cljfmt-fix {:extra-deps {cljfmt/cljfmt {:mvn/version "0.9.2"}}
                        :main-opts ["-m" "cljfmt.main" "fix"
                                    "--parallel"
                                    "--remove-multiple-non-indenting-spaces"
                                    "--file-pattern" "\\.(clj[csx]?|edn)$"]}}}
