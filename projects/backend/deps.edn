{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.1"}
        cheshire/cheshire {:mvn/version "6.0.0"}
        clj-http/clj-http {:mvn/version "3.13.1"}
        tick/tick {:mvn/version "1.0"}
        org.clojure/data.xml {:mvn/version "0.2.0-alpha9"}
        com.sernamar/dinero {:mvn/version "0.3.0"
                             :exclusions [hato/hato
                                          com.github.seancorfield/next.jdbc
                                          com.h2database/h2]}}
 :aliases
 {:run {:main-opts ["-e"
                    "(do (try (require 'dev) (catch Throwable _ nil)) (require 'backend.main) (apply (resolve 'backend.main/-main) *command-line-args*))"]}
  :dev {:extra-paths ["dev"]}
  :repl {:main-opts ["-m" "nrepl.cmdline"
                     "-p" "56565"
                     "--interactive"
                     #_#_"--repl-fn" "repl/-repl"]
         :extra-deps {nrepl/nrepl {:mvn/version "1.3.1"}
                      com.bhauman/rebel-readline {:mvn/version "0.1.5"}}}
  :test {:extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                      clj-http-fake/clj-http-fake {:mvn/version "1.0.4"}}
         :main-opts ["-m" "kaocha.runner"]}
  :nsorg-check {:extra-deps {nsorg-cli/nsorg-cli {:mvn/version "0.3.1"}}
                :main-opts ["-m" "nsorg.cli"]}

  :nsorg-fix {:extra-deps {nsorg-cli/nsorg-cli {:mvn/version "0.3.1"}}
              :main-opts ["-m" "nsorg.cli" "--replace"]}

  :cljfmt-check {:extra-deps {cljfmt/cljfmt {:mvn/version "0.9.2"}}
                 :main-opts ["-m" "cljfmt.main" "check"
                             "--parallel"
                             "--remove-multiple-non-indenting-spaces"
                             "--file-pattern" "\\.(clj[csx]?|edn)$"]}

  :cljfmt-fix {:extra-deps {cljfmt/cljfmt {:mvn/version "0.9.2"}}
               :main-opts ["-m" "cljfmt.main" "fix"
                           "--parallel"
                           "--remove-multiple-non-indenting-spaces"
                           "--file-pattern" "\\.(clj[csx]?|edn)$"]}}}
