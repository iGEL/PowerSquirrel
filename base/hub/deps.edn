{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.1"}

        ;; shared library choices with the cloud
        integrant/integrant {:mvn/version "1.0.1"}
        aero/aero           {:mvn/version "1.1.6"}
        cheshire/cheshire   {:mvn/version "6.0.0"}

        ;; core loop: MQTT -> aggregate -> SQLite
        org.eclipse.paho/org.eclipse.paho.mqttv5.client {:mvn/version "1.2.5"}
        com.layerware/hugsql-core              {:mvn/version "0.5.3"}
        com.layerware/hugsql-adapter-next-jdbc {:mvn/version "0.5.3"}
        com.github.seancorfield/next.jdbc      {:mvn/version "1.3.1108"}
        org.xerial/sqlite-jdbc                 {:mvn/version "3.49.1.0"}
        migratus/migratus                      {:mvn/version "1.6.6"}

        ;; logging
        com.taoensso/telemere {:mvn/version "1.2.1"}}

 ;; --- sync layer (added when the /fetch-objects, /upsert-objects, ...
 ;;     endpoints land; see docs/sync.md). Versions pinned to latest now: ---
 ;; http-kit/http-kit            {:mvn/version "2.8.0"}   ; 2.9.0 is beta-only
 ;; metosin/reitit-ring          {:mvn/version "0.10.1"}  ; matches web's reitit-frontend
 ;; metosin/muuntaja             {:mvn/version "0.6.11"}  ; transit+json <-> json negotiation
 ;; com.cognitect/transit-clj    {:mvn/version "1.0.333"} ; custom Money handlers
 ;; metosin/malli                {:mvn/version "0.20.1"}  ; object validation + request coercion
 ;; com.github.f4b6a3/uuid-creator {:mvn/version "6.1.1"} ; UUID v7 (sync.md requirement)
 ;; com.sernamar/dinero          {:mvn/version "0.3.1"}   ; shared price/fee logic from cloud

 :aliases
 {:run {:main-opts ["-m" "hub.main"]}

  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.6"}}
          :ns-default build}

  :dev {:extra-paths ["dev"]}

  :repl {:main-opts ["-m" "nrepl.cmdline" "-p" "56566" "--interactive"]
         :extra-paths ["dev"]
         :extra-deps {nrepl/nrepl {:mvn/version "1.3.1"}
                      com.bhauman/rebel-readline {:mvn/version "0.1.5"}}}

  :test {:extra-paths ["test"]
         :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}}
         :main-opts ["-m" "kaocha.runner"]}

  :cljfmt-check {:extra-deps {cljfmt/cljfmt {:mvn/version "0.9.2"}}
                 :main-opts ["-m" "cljfmt.main" "check"
                             "--parallel"
                             "--remove-multiple-non-indenting-spaces"
                             "--file-pattern" "\\.(clj[csx]?|edn)$"]}

  :cljfmt-fix {:extra-deps {cljfmt/cljfmt {:mvn/version "0.9.2"}}
               :main-opts ["-m" "cljfmt.main" "fix"
                           "--parallel"
                           "--remove-multiple-non-indenting-spaces"
                           "--file-pattern" "\\.(clj[csx]?|edn)$"]}

  :nsorg-check {:extra-deps {nsorg-cli/nsorg-cli {:mvn/version "0.3.1"}}
                :main-opts ["-m" "nsorg.cli"]}

  :nsorg-fix {:extra-deps {nsorg-cli/nsorg-cli {:mvn/version "0.3.1"}}
              :main-opts ["-m" "nsorg.cli" "--replace"]}}}
